# Optional local delivery mode: requires NODE_ENV=development (npm run dev).
# Production rejects console mode. Leave unset to use normal SMS delivery.
OTP_DELIVERY_MODE=console
# Status notifications use a separate generic status-change template, with no
# admin message or customer details. Enable real delivery only in production.
# ORDER_NOTIFICATIONS_SMS_ENABLED=true
# FARAZSMS_ORDER_STATUS_PATTERN_CODE=
