generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "entity", "upro"]
}

model User {
  id       String   @id @db.Uuid
  email    String   @unique
  contact  String?
  cr       DateTime?
  password String
  fname    String?
  lname    String?
  natcode  String?

  orders   Order[]  @relation("ClientOrders")

  @@map("users")
  @@schema("entity")
}

model Order {
  order_id     Int     @id @default(autoincrement())
  client_id    String  @db.Uuid

  type         String   // web, game, mobile...
  page_count   Int?     // size indicator
  budget_range String   // <1k, 1-5k, 5-10k, 10k+
  status       String   // draft, submitted, etc

  description  String?

  meta         Json?    // ONLY extras

  client       User    @relation("ClientOrders", fields: [client_id], references: [id])

  @@map("orders")
  @@schema("entity")
}

model Comment {
  id                Int       @id @default(autoincrement())
  entity_type       String
  entity_id         Int
  parent_id         Int?
  author_profile_id Int?
  guest_name        String?
  guest_email       String?
  content           String
  status            String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  @@map("comments")
  @@schema("entity")
}

model BlogPost {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  excerpt           String?
  content           String
  status            String?
  author_profile_id Int?
  cover_media_id    Int?
  published_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  tags              String?

  @@map("blog_posts")
  @@schema("entity")
}

model PersonProfile {
  pr_id      Int     @id @default(autoincrement())
  user_id    String  @db.Uuid
  pr_company String?
  role       String?

  @@map("person_profile")
  @@schema("upro")
}
